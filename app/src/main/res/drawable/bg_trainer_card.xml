<?xml version="1.0" encoding="utf-8"?>
<!-- Marco de la tarjeta de entrenador (ver MainActivity.showTrainerCardDialog): degradado suave
     a juego con el rojo de cabecera de TrainerSetupActivity, con borde marcado - el "marco de
     tarjeta" que un AlertDialog corriente no tiene. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FFF6D6D6"
        android:endColor="#FFFFFFFF" />
    <corners android:radius="16dp" />
    <stroke android:width="2dp" android:color="#EE1515" />
</shape>
