<?xml version="1.0" encoding="utf-8"?>
<!-- Primer arranque (guiado por el Profesor Oak, como en los juegos: dialogo -> genero -> retrato
     -> nombre) Y edicion posterior desde la ficha de entrenador (mismo flujo, sin la charla
     introductoria) - ver TrainerSetupActivity.EXTRA_EDIT_MODE. SIEMPRE en secuencia, un paso a la
     vez (pedido explicito del usuario). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trainer_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B1B1B">

    <!-- Caja de dialogo de Oak: retrato GRANDE y texto, los dos centrados y usando TODO el
         espacio disponible (pedido explicito del usuario), no solo una franja de arriba. El peso
         de esta caja frente al area de contenido de abajo se ajusta en codigo segun el paso
         (TrainerSetupActivity.setOakBoxWeight): grande en narracion/genero/nombre, pequeña
         cuando toca la rejilla de retratos (esa si necesita el espacio). -->
    <FrameLayout
        android:id="@+id/oak_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="#EE1515"
        android:padding="20dp">
        <!-- Progreso del tutorial (arriba del todo) - pedido explicito del usuario: "una barra
             que informe de cuanto le queda... para que sepa que no es tanto". Solo visible
             durante la fase de tutorial (ver TrainerSetupActivity.showTutorialStep), oculta en
             narracion inicial/genero/retrato/nombre. -->
        <ProgressBar
            android:id="@+id/tutorial_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="top"
            android:max="100"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:id="@+id/stage_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/oak_portrait"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                    <!-- Pokemon aleatorio/de demo: aparece JUNTO a Oak (no lo sustituye), como si
                         lo sacara de la Pokedex - pedido explicito del usuario. Caja SIEMPRE
                         visible (aunque vacia) de tamaño fijo, para que su posicion en pantalla
                         (getLocationOnScreen, ver TrainerSetupActivity.animateBallThrow) sea
                         fiable desde el primer layout - a diferencia de una vista "gone", que no
                         tiene una posicion real hasta que se hace visible. El huevo del paso de
                         huevos vive DENTRO de esta misma caja (ver egg_reveal) en vez de sumar
                         mas ancho a la fila, que se salia de pantalla - pedido explicito del
                         usuario ("el huevo esta fuera de la pantalla"). -->
                    <FrameLayout
                        android:id="@+id/pokemon_reveal_frame"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginStart="12dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">
                        <!-- Un poco mas estrecho que la caja y pegado al INICIO (start): dejando
                             hueco a la derecha para el huevo, sin taparse - "el Pokemon un poco a
                             la izquierda", pedido explicito del usuario. -->
                        <ImageView
                            android:id="@+id/pokemon_reveal"
                            android:layout_width="115dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="start|center_vertical"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null"
                            android:visibility="gone" />
                        <!-- Huevo del paso de huevos: pegado al Pokemon, asomando por la esquina
                             INFERIOR derecha (puede solaparse un poco) - pedido explicito del
                             usuario ("el huevo pegado a el a la derecha, puede estar un poco
                             encima [del Pokemon, no arriba en la caja], no hace falta que este tan
                             separado" - corregido tras verlo arriba en vez de abajo). -->
                        <ImageView
                            android:id="@+id/egg_reveal"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="end|bottom"
                            android:layout_marginEnd="-6dp"
                            android:layout_marginBottom="-2dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
                <!-- Pokeball lanzada (assets/pokeballs, ver TrainerSetupActivity.
                     animateBallThrow): sale de junto a Oak, gira, y se abre justo antes de
                     revelar el Pokemon en pokemon_reveal - pedido explicito del usuario. -->
                <ImageView
                    android:id="@+id/ball_throw"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="40dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/ball_burst"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="end|center_vertical"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/oak_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="¡Hola!"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/btn_edit_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="14dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:padding="6dp"
            android:visibility="gone" />
        <!-- Solo visible durante el tutorial (ver TrainerSetupActivity.startTutorial) - pedido
             explicito del usuario: poder saltarlo. -->
        <TextView
            android:id="@+id/btn_skip_tutorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="14dp"
            android:text="Saltar ▶▶"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="6dp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <!-- Solo narracion: avanzar a la siguiente linea de Oak. widget_preview_container: solo
             visible en los pasos que lo piden (ver TrainerSetupActivity.showPreviewFor) - ocupa
             TODO el hueco que sobra (peso 1) por encima del boton, pedido explicito del usuario
             ("que ocupe toda la parte negra de abajo" - se veia demasiado pequeño). -->
        <LinearLayout
            android:id="@+id/panel_continue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="16dp">
            <FrameLayout
                android:id="@+id/widget_preview_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/btn_continue_narration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continuar ▶" />
        </LinearLayout>

        <!-- Elegir genero: retrato generico de chico/chica (CHICO.png/CHICA.png, ya existen en
             el propio pack) en vez de emojis - pedido explicito del usuario. -->
        <LinearLayout
            android:id="@+id/panel_gender"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/btn_gender_boy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <ImageView
                    android:id="@+id/gender_boy_img"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chico"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_gender_girl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <ImageView
                    android:id="@+id/gender_girl_img"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chica"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Elegir retrato (filtrado por genero, agrupado por categoria). -->
        <LinearLayout
            android:id="@+id/panel_sprite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trainer_sprites"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="4dp" />
            <Button
                android:id="@+id/btn_sprite_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:text="Continuar" />
        </LinearLayout>

        <!-- Elegir nickname. -->
        <LinearLayout
            android:id="@+id/panel_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">
            <EditText
                android:id="@+id/input_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tu nickname"
                android:maxLines="1"
                android:inputType="textPersonName|textCapWords" />
            <Button
                android:id="@+id/btn_name_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Continuar" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
